# ==========================================
# KadaiAI Mobile App Environment Configuration
# ==========================================

# Base URL pointing to the FastAPI backend.
# - For Local Web development (browser): http://127.0.0.1:8000
# - For Physical Device (Expo Go) / Android Emulator: http://YOUR_COMPUTER_IP:8000
# Find your IP on Windows using: ipconfig (e.g. 192.168.1.5)
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
